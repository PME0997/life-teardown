# Life Teardown .gitattributes
# 跨平台换行符策略——这对 Windows/macOS 双平台项目至关重要。

# 默认：文本文件自动识别，仓库内统一以 LF 存储
* text=auto

# Shell 脚本强制 LF：CRLF 会导致 macOS/Linux 上 bash 报 `\r: command not found`
*.sh text eol=lf

# PowerShell / 批处理用 CRLF（Windows 专用脚本）
*.ps1 text eol=crlf
*.bat text eol=crlf

# 其余文本显式 LF（避免 Windows 贡献者引入 CRLF）
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# 二进制文件，禁止任何换行转换
*.zip binary
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
